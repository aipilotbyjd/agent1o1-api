# Copy to deploy/glitchtip/.env. Never commit the real file.
# Generate SECRET_KEY with: openssl rand -hex 32
SECRET_KEY=
POSTGRES_PASSWORD=
# Public URL GlitchTip is reached at. Must match the host in the DSN.
GLITCHTIP_DOMAIN=http://localhost:8000
# GLITCHTIP_PORT=8000
# GLITCHTIP_VERSION=latest
# SMTP, e.g. smtp://user:pass@smtp.example.com:587/?tls=True. Default prints emails to the log.
# EMAIL_URL=consolemail://
# DEFAULT_FROM_EMAIL=glitchtip@example.com
# Turn off once your team has signed up.
# ENABLE_USER_REGISTRATION=true
# ENABLE_ORGANIZATION_CREATION=true
# GLITCHTIP_MAX_EVENT_LIFE_DAYS=90
