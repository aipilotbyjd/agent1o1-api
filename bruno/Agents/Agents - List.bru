meta {
  name: Agents - List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/agents
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
}

params:query {
  ~per_page: 25
  ~cursor: 
  ~tag_id: {{tagId}}
}

docs {
  Lists the workspace's agents, newest first, each with its `tags`,
  `sessions_count` and last session activity. Requires the `agent.view`
  permission. Trashed agents are excluded (see `Agents - Trash`).

  - `tag_id` — optional uuid; only agents with that tag.

  Cursor-paginated: `?per_page=` (1-100, default 25) and `?cursor=` (the
  previous page's `meta.next_cursor`). Response is
  `{ success, statusCode, message, data, meta: { per_page, next_cursor,
  prev_cursor, has_more } }`; keep requesting with `next_cursor` while
  `has_more` is true.
}
