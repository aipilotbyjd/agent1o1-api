meta {
  name: Eval Runs - List
  type: http
  seq: 27
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/agents/:agent/eval-suites/:suite/runs
  body: none
  auth: inherit
}

params:query {
  ~per_page: 25
  ~cursor: 
}

params:path {
  workspace: {{workspaceId}}
  agent: {{agentId}}
  suite: {{evalSuiteId}}
}

docs {
  Lists past executions of the suite, newest first. Requires the
  `agent.view` permission.

  Cursor-paginated: `?per_page=` (1-100, default 25) and `?cursor=` (the
  previous page's `meta.next_cursor`). Response is
  `{ success, statusCode, message, data, meta: { per_page, next_cursor,
  prev_cursor, has_more } }`; keep requesting with `next_cursor` while
  `has_more` is true.
}
