meta {
  name: Agents - Trash
  type: http
  seq: 67
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/agents/trash
  body: none
  auth: inherit
}

params:query {
  ~per_page: 25
  ~cursor: 
}

params:path {
  workspace: {{workspaceId}}
}

docs {
  Lists the workspace's soft-deleted agents, most recently trashed first,
  each with its `tags`. Requires the `agent.view` permission.

  Bring one back with `Agents - Restore`, or remove it for good with
  `Agents - Force Delete`.

  Cursor-paginated: `?per_page=` (1-100, default 25) and `?cursor=` (the
  previous page's `meta.next_cursor`). Response is
  `{ success, statusCode, message, data, meta: { per_page, next_cursor,
  prev_cursor, has_more } }`; keep requesting with `next_cursor` while
  `has_more` is true.
}
