meta {
  name: Versions - List
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/agents/:agent/versions
  body: none
  auth: inherit
}

params:query {
  ~per_page: 25
  ~cursor: 
}

params:path {
  workspace: {{workspaceId}}
  agent: {{agentId}}
}

docs {
  The agent's behavioral history, highest version number first. Requires
  the `agent.view` permission.

  Versions are written automatically when the agent is edited — there's no
  endpoint to mint one by hand, because a version that didn't correspond to
  a real edit would make the history lie.

  Cursor-paginated: `?per_page=` (1-100, default 25) and `?cursor=` (the
  previous page's `meta.next_cursor`). Response is
  `{ success, statusCode, message, data, meta: { per_page, next_cursor,
  prev_cursor, has_more } }`; keep requesting with `next_cursor` while
  `has_more` is true.
}
