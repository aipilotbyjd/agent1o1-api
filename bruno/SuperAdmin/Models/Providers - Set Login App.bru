meta {
  name: Providers - Set Login App
  type: http
  seq: 33
}

put {
  url: {{baseUrl}}/super-admin/v1/models/providers/:provider/connect-credentials
  body: json
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:path {
  provider: huggingface
}

body:json {
  {
    "client_id": "your-oauth-client-id",
    "client_secret": "your-oauth-client-secret",
    "reason": "Our Hugging Face login app",
    "totp_code": "123456"
  }
}

docs {
  Stores the one-click login app (OAuth client) for Hugging Face or Sign in with ChatGPT, encrypted, over the `.env` values. Never returned. Needs a reason and a fresh code. OpenRouter needs none (422).
}
