meta {
  name: Programs - Simulate
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/super-admin/v1/referrals/programs/:program/simulate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{superAdminToken}}
}

params:path {
  program: {{referralProgramId}}
}

body:json {
  {
    "trigger": "first_payment",
    "payment_cents": 9900,
    "billing_interval": "monthly",
    "payment_source": "subscription",
    "payment_sequence": 1,
    "multiplier": 1
  }
}

docs {
  Dry run: what each rule would give for a hypothetical event. Writes
  nothing. `trigger` is required (`signup_verified`, `activated`,
  `first_payment`, `repeat_payment`, `milestone`); payment fields
  (`payment_cents`, `plan_id`, `billing_interval`, `payment_source`,
  `payment_sequence`) apply to payment triggers, `converted_referrals` to
  milestones, `multiplier` mimics a referral code's multiplier.

  Response is wrapped:
  `{ success, statusCode, message, data: { program_id, program_is_live, results } }`.
}
