meta {
  name: Workflows - Trash
  type: http
  seq: 37
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/workflows/trash
  body: none
  auth: inherit
}

params:query {
  ~per_page: 25
  ~cursor: 
}

params:path {
  workspace: {{workspaceId}}
}

docs {
  Lists the workspace's deleted (soft-deleted) workflows, most recently
  deleted first. Requires the `workflow.view` permission.

  Each workflow carries `deleted_at`. Bring one back with
  `Workflows - Restore` or remove it for good with `Workflows - Force Delete`.

  Cursor-paginated: `?per_page=` (1-100, default 25) and `?cursor=` (the
  previous page's `meta.next_cursor`). Response is
  `{ success, statusCode, message, data, meta: { per_page, next_cursor,
  prev_cursor, has_more } }`; keep requesting with `next_cursor` while
  `has_more` is true.
}
