meta {
  name: Publish Requests - List Workspace
  type: http
  seq: 48
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/publish-requests
  body: none
  auth: inherit
}

params:query {
  ~per_page: 25
  ~cursor: 
}

params:path {
  workspace: {{workspaceId}}
}

docs {
  The approvals inbox: every pending publish request in the workspace,
  oldest first. Requires the `workflow.view` permission.

  Items leave out the graph and carry `workflow: { id, name }`,
  `requester`, `base_version`, `notes`, `can_review` and `can_withdraw`.

  Cursor-paginated: `?per_page=` (1-100, default 25) and `?cursor=` (the
  previous page's `meta.next_cursor`). Response is
  `{ success, statusCode, message, data, meta: { per_page, next_cursor,
  prev_cursor, has_more } }`; keep requesting with `next_cursor` while
  `has_more` is true.
}
