meta {
  name: Folders - List
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/folders
  body: none
  auth: inherit
}

params:query {
  ~per_page: 25
  ~cursor: 
  ~type: agent
}

params:path {
  workspace: {{workspaceId}}
}

docs {
  Lists the workspace's top-level folders of one type, ordered by
  `position`, each with its `children` nested one level deep plus
  `workflow_count` and `agent_count`.

  `?type=workflow` (the default) needs the `workflow.view` permission;
  `?type=agent` lists agent folders and needs `agent.view`.

  Cursor-paginated: `?per_page=` (1-100, default 25) and `?cursor=` (the
  previous page's `meta.next_cursor`). Response is
  `{ success, statusCode, message, data, meta: { per_page, next_cursor,
  prev_cursor, has_more } }`; keep requesting with `next_cursor` while
  `has_more` is true.
}
