meta {
  name: Versions - List
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/workflows/:workflow/versions
  body: none
  auth: inherit
}

params:query {
  ~per_page: 25
  ~cursor: 
}

params:path {
  workspace: {{workspaceId}}
  workflow: {{workflowId}}
}

docs {
  Lists the workflow's published versions, highest version number first.
  Requires the `workflow.version` permission.

  Cursor-paginated: `?per_page=` (1-100, default 25) and `?cursor=` (the
  previous page's `meta.next_cursor`). Response is
  `{ success, statusCode, message, data, meta: { per_page, next_cursor,
  prev_cursor, has_more } }`; keep requesting with `next_cursor` while
  `has_more` is true.
}
