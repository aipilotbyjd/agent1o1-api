meta {
  name: Workflows - List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/workflows
  body: none
  auth: inherit
}

params:query {
  ~per_page: 25
  ~cursor: 
}

params:path {
  workspace: {{workspaceId}}
}

docs {
  Lists the workspace's visible workflows, newest first; trashed ones are
  in `Workflows - Trash`. Requires the `workflow.view` permission.

  Each item adds `nodes_count`, `node_types`, `last_run_at` and the
  caller's `is_favorite`.

  Cursor-paginated: `?per_page=` (1-100, default 25) and `?cursor=` (the
  previous page's `meta.next_cursor`). Response is
  `{ success, statusCode, message, data, meta: { per_page, next_cursor,
  prev_cursor, has_more } }`; keep requesting with `next_cursor` while
  `has_more` is true.
}
