meta {
  name: Record Signup Attribution
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/v1/user/signup-attribution
  body: json
  auth: inherit
}

body:json {
  {
    "attribution": {
      "utm_source": "youtube",
      "template": "sales-call-prep-brief"
    }
  }
}

docs {
  Where a Google or GitHub signup came from, sent by the browser straight
  after the account is made (an email signup sends the same object with
  `Register`). Same fields as `Register`'s `attribution`. Only the first
  set is kept, and only for an account made in the last day; otherwise
  the call changes nothing.

  Response is wrapped: `{ success, statusCode, message }`.
}
