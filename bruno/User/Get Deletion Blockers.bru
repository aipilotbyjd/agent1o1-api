meta {
  name: Get Deletion Blockers
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/v1/user/deletion-blockers
  body: none
  auth: inherit
}

docs {
  What the delete-account dialog needs up front: `workspaces` (owned
  workspaces that would block deletion, each `{ id, name, reasons }`)
  and `requires_password`.

  Response is wrapped: `{ success, statusCode, message, data: { workspaces, requires_password } }`.
}
