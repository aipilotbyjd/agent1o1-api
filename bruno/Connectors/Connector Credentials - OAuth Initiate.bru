meta {
  name: Connector Credentials - OAuth Initiate
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/v1/workspaces/:workspace/connector-credentials/oauth/initiate
  body: json
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
}

body:json {
  {
    "connector_id": "{{connectorId}}",
    "name": "My GitHub",
    "redirect_uri": "https://app.test/callback",
    "scope": "team"
  }
}

script:post-response {
  if (res.status === 200) {
    const state = res.body.data?.state;
    if (state) {
      bru.setVar("oauthState", state);
    }
  }
}

docs {
  Starts the OAuth2 dance for an `auth_type = oauth2` connector: stores a
  short-lived `state` row and returns the provider's authorize URL for the
  frontend to redirect the user to. Requires the `connector.manage`
  permission. Stores the returned state as `oauthState` for use with
  `- OAuth Callback`.

  `scope` — optional, `team` (default) or `personal`, carried through the
  redirect to decide the resulting credential's visibility once
  `- OAuth Callback` completes — see `Connector Credentials - Create`'s
  docs for what each means.

  `credential_id` — optional UUID of an existing credential for the same
  connector (visible to the caller) to *reconnect*: the callback then
  refreshes that credential, keeping its name and scope, instead of
  creating a new one. 404 if not found.

  `connector_id` (UUID), `name` (max 255) and `redirect_uri` (URL) are
  required.

  Response is wrapped: `{ success, statusCode, message, data: { authorize_url, state } }`.
}
