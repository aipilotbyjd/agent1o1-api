meta {
  name: Versions - List
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/pages/:page/versions
  body: none
  auth: inherit
}

params:query {
  ~per_page: 25
  ~cursor: 
}

params:path {
  workspace: {{workspaceId}}
  page: {{pageId}}
}

docs {
  Lists the page's version history, newest number first, without content.
  Requires the `page.manage` permission.

  Each entry has `number`, `kind` (`published`, `saved`, `before_restore`,
  `before_generation`), `label`, `has_variant`, `created_by`.

  Cursor-paginated: `?per_page=` (1-100, default 25) and `?cursor=` (the
  previous page's `meta.next_cursor`). Response is
  `{ success, statusCode, message, data, meta: { per_page, next_cursor,
  prev_cursor, has_more } }`; keep requesting with `next_cursor` while
  `has_more` is true.
}
