meta {
  name: Sections - List
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/page-sections
  body: none
  auth: inherit
}

params:query {
  ~per_page: 25
  ~cursor: 
}

params:path {
  workspace: {{workspaceId}}
}

docs {
  Lists the workspace's saved page sections (reusable blocks), most
  recently updated first. Requires the `page.manage` permission.

  Each section has `id`, `name`, `block`, `created_by`.

  Cursor-paginated: `?per_page=` (1-100, default 25) and `?cursor=` (the
  previous page's `meta.next_cursor`). Response is
  `{ success, statusCode, message, data, meta: { per_page, next_cursor,
  prev_cursor, has_more } }`; keep requesting with `next_cursor` while
  `has_more` is true.
}
