meta {
  name: Pages - List
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/workspaces/:workspace/pages
  body: none
  auth: inherit
}

params:path {
  workspace: {{workspaceId}}
}

params:query {
  ~per_page: 25
  ~cursor: 
  ~workflow_id: {{workflowId}}
}

docs {
  Lists the workspace's pages, most recently updated first. Requires the
  `page.view` permission.

  - `workflow_id` — optional, only pages for that workflow.

  Each entry is the page without its `content` blocks, plus `runs_count`
  (non-test submissions) and `last_run_at`.

  Cursor-paginated: `?per_page=` (1-100, default 25) and `?cursor=` (the
  previous page's `meta.next_cursor`). Response is
  `{ success, statusCode, message, data, meta: { per_page, next_cursor,
  prev_cursor, has_more } }`; keep requesting with `next_cursor` while
  `has_more` is true.
}
