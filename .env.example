TRIGGERS_YOUTUBE_WEBSUB_HUB=https://pubsubhubbub.appspot.com/subscribe

# Notion: the webhook verification token from the integration, then switch on.
TRIGGERS_PUSH_NOTION_ENABLED=false
TRIGGERS_NOTION_VERIFICATION_TOKEN=

# --- Instant (push) triggers: off by default ---------------------------------
TRIGGERS_PUSH_OUTLOOK_ENABLED=false
TRIGGERS_PUSH_GOOGLE_DRIVE_ENABLED=false
TRIGGERS_PUSH_GOOGLE_CALENDAR_ENABLED=false
TRIGGERS_PUSH_GOOGLE_SHEETS_ENABLED=false
TRIGGERS_PUSH_GOOGLE_DOCS_ENABLED=false
TRIGGERS_PUSH_GITHUB_ENABLED=false
TRIGGERS_PUSH_LINEAR_ENABLED=false
TRIGGERS_PUSH_JIRA_ENABLED=false

# --- Instant (push) triggers: on by default ----------------------------------
TRIGGERS_PUSH_TELEGRAM_ENABLED=true
TRIGGERS_PUSH_DISCORD_ENABLED=true
TRIGGERS_PUSH_TWILIO_ENABLED=true
TRIGGERS_PUSH_TYPEFORM_ENABLED=true
TRIGGERS_PUSH_MAILCHIMP_ENABLED=true
TRIGGERS_PUSH_KIT_ENABLED=true
TRIGGERS_PUSH_ACTIVECAMPAIGN_ENABLED=true
TRIGGERS_PUSH_RESEND_ENABLED=true
TRIGGERS_PUSH_POSTMARK_ENABLED=true
TRIGGERS_PUSH_MAILGUN_ENABLED=true
TRIGGERS_PUSH_STRIPE_ENABLED=true
TRIGGERS_PUSH_SHOPIFY_ENABLED=true
TRIGGERS_PUSH_TRELLO_ENABLED=true
TRIGGERS_PUSH_ASANA_ENABLED=true
TRIGGERS_PUSH_CLICKUP_ENABLED=true
TRIGGERS_PUSH_MONDAY_ENABLED=true
TRIGGERS_PUSH_AIRTABLE_ENABLED=true
TRIGGERS_PUSH_PIPEDRIVE_ENABLED=true
TRIGGERS_PUSH_ZOHO_ENABLED=true
TRIGGERS_PUSH_ZOHO_DESK_ENABLED=true

# --- Queues & job timeouts ---------------------------------------------------
TRIGGERS_FIRE_QUEUE=triggers-event
TRIGGERS_POLL_QUEUE=triggers-poll
TRIGGERS_AGENT_FIRE_QUEUE=ai-agent
TRIGGERS_FIRE_TIMEOUT_SECONDS=120
TRIGGERS_AGENT_FIRE_TIMEOUT_SECONDS=320
TRIGGERS_FIRE_MAX_EXCEPTIONS=5
TRIGGERS_FIRE_LOCK_RELEASE_AFTER_SECONDS=30
TRIGGERS_FIRE_LOCK_EXPIRE_AFTER_SECONDS=300

# --- Stuck-run recovery ------------------------------------------------------
TRIGGERS_STUCK_QUEUED_AFTER_MINUTES=10
TRIGGERS_STUCK_RUNNING_AFTER_MINUTES=15
TRIGGERS_STUCK_BATCH_SIZE=100

# --- Retention & pruning -----------------------------------------------------
TRIGGERS_EVENTS_RETENTION_DAYS=30
TRIGGERS_PRUNE_CHUNK=1000
TRIGGERS_PRUNE_AT=03:30

