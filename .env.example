# --- Branding ----------------------------------------------------------------
# The only place the assistant's name is set. See docs/ASSISTANT_BRANDING_PLAN.md.
# After changing: `php artisan config:cache && php artisan assistant:brand-refresh`.
ASSISTANT_NAME=Orb
ASSISTANT_TAGLINE="Your personal AI agent"
ASSISTANT_DESCRIPTION="Reads your apps, preps your day and handles your inbox."
ASSISTANT_EMOJI=🔮
ASSISTANT_COLOR=#7C3AED
ASSISTANT_ICON_URL=/brand/assistant/icon.svg
ASSISTANT_AVATAR_URL=/brand/assistant/icon.svg
ASSISTANT_FEATURE_DAILY=":name Daily"
ASSISTANT_FEATURE_INBOX=":name Inbox"
ASSISTANT_FEATURE_PREP=":name Prep"
ASSISTANT_FEATURE_SITUATIONS=Situations
ASSISTANT_EMAIL=orb
ASSISTANT_EMAIL_ALIASES=
ASSISTANT_INBOUND_DOMAIN=agent1o1.com
ASSISTANT_SMS_SIGNATURE="— :name"

# --- Channels (docs/ASSISTANT_PLAN.md §7) -------------------------------------
ASSISTANT_EMAIL_INBOUND_TOKEN=
ASSISTANT_EMAIL_REQUIRE_AUTH=true
ASSISTANT_SLACK_CLIENT_ID=
ASSISTANT_SLACK_CLIENT_SECRET=
ASSISTANT_SLACK_SIGNING_SECRET=

# --- SMS (Twilio) ------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ASSISTANT_SMS_FROM=
# Public URL Twilio posts incoming SMS to.
ASSISTANT_SMS_WEBHOOK_URL=

# =============================================================================
# WORKFLOW & AGENT TRIGGERS (config/triggers.php) — defaults shown
# =============================================================================
TRIGGERS_NODES_ENABLED=true

# --- Failure handling --------------------------------------------------------
TRIGGERS_FAILURES_BEFORE_DISABLE=3
TRIGGERS_SKIPS_BEFORE_DISABLE=25

# --- Webhooks ----------------------------------------------------------------
TRIGGERS_HOOK_RATE_LIMIT_PER_MINUTE=120
TRIGGERS_MAX_WEBHOOK_BODY_KB=1024
TRIGGERS_PAYLOAD_SNIPPET_CHARS=5000

# --- Scheduling & polling ----------------------------------------------------
TRIGGERS_SCHEDULE_CATCH_UP_MINUTES=10
TRIGGERS_POLL_EVERY_MINUTES=15
TRIGGERS_MIN_POLL_INTERVAL_MINUTES=1
TRIGGERS_POLL_MAX_ITEMS=100
TRIGGERS_POLL_LOCK_SECONDS=600
TRIGGERS_PUSH_RECONCILE_POLL_MINUTES=15
TRIGGERS_ADAPTIVE_POLL=true
TRIGGERS_ADAPTIVE_POLL_AFTER=6
TRIGGERS_ADAPTIVE_POLL_MAX=4
TRIGGERS_POLL_TRANSIENT_FAILURES_BEFORE_COUNT=30

# --- Run limits --------------------------------------------------------------
TRIGGERS_MAX_CONCURRENT_RUNS_PER_WORKSPACE=25
TRIGGERS_MAX_SYNC_WAIT_SECONDS=25
TRIGGERS_PROVIDER_EVENTS_RETENTION_DAYS=7
TRIGGERS_CONCURRENCY_RELEASE_SECONDS=15
TRIGGERS_DEBOUNCE_MAX_WAIT_SECONDS=3600
TRIGGERS_REMOVAL_MAX_TRACKED=2000

# --- Event storm protection --------------------------------------------------
TRIGGERS_STORM_ENABLED=true
TRIGGERS_STORM_MAX_EVENTS_PER_MINUTE=300

# --- Agent follow-ups --------------------------------------------------------
TRIGGERS_AGENT_FOLLOW_UPS_MAX_ACTIVE=25
TRIGGERS_AGENT_FOLLOW_UPS_MAX_DAYS_AHEAD=365
TRIGGERS_AGENT_FOLLOW_UPS_MIN_INTERVAL_MINUTES=60

# --- Instant (push) triggers: needing setup ----------------------------------
# Slack: the connector app's signing secret, then switch on.
TRIGGERS_PUSH_SLACK_ENABLED=false
TRIGGERS_SLACK_SIGNING_SECRET=

