# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME="Agent1o1 API"
# `local` relaxes the Stripe webhook signature and the Horizon/Pulse gates, and only
# on a development host (localhost, *.test). Set `production` on any deployed server.
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# =============================================================================
# LOGGING
# =============================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# DATABASE
# =============================================================================
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# =============================================================================
# SESSION, CACHE, QUEUE & STORAGE
# =============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Knowledge/skill syncs and reflections. Defaults to `redis-long` when
# QUEUE_CONNECTION=redis, otherwise to QUEUE_CONNECTION.
# LONG_QUEUE_CONNECTION=redis-long
# Seconds before a job on the long or assistant queue is retried.
# LONG_QUEUE_RETRY_AFTER=960
# ASSISTANT_QUEUE_RETRY_AFTER=1260

CACHE_STORE=database
# CACHE_PREFIX=

# --- Memcached ---------------------------------------------------------------
MEMCACHED_HOST=127.0.0.1

# --- Redis -------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =============================================================================
# MAIL
# =============================================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# AWS
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# S3-compatible storage (R2, MinIO…): the bucket's public URL and API endpoint.
# AWS_URL=
# AWS_ENDPOINT=

# =============================================================================
# VITE
# =============================================================================
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# =============================================================================
# REVERB (WEBSOCKETS)
# =============================================================================
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# Hosts allowed to open websocket connections (comma-separated). Defaults to the APP_FRONTEND_URL host.
# REVERB_ALLOWED_ORIGINS=
# Set to true when more than one Reverb server runs: they then share events through Redis.
# REVERB_SCALING_ENABLED=false

# =============================================================================
# AI PROVIDERS
# =============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
FIREWORKS_API_KEY=
TOGETHER_API_KEY=
VERBOO_API_KEY=
VYCE_URL=
VYCE_API_KEY=
XKIRO_API_KEY=
# Leave empty to make Hugging Face models run only on workspaces' own connections.
HUGGINGFACE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
COHERE_API_KEY=
JINA_API_KEY=
VOYAGEAI_API_KEY=
ELEVENLABS_API_KEY=
OLLAMA_API_KEY=
# OLLAMA_URL=http://localhost:11434

# --- Provider base URLs (defaults shown) -------------------------------------
# OPENAI_URL=https://api.openai.com/v1
# ANTHROPIC_URL=https://api.anthropic.com/v1
# GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/
# FIREWORKS_URL=https://api.fireworks.ai/inference/v1
# TOGETHER_URL=https://api.together.xyz/v1
# VERBOO_URL=https://code.verboo.ai/router/v1
# XKIRO_URL=https://api.xkiro.com/v1
# HUGGINGFACE_URL=https://router.huggingface.co/v1
# OPENAI_STORE=true
# Comma-separated providers whose structured output is forced through a tool call.
# AI_STRUCTURED_OUTPUT_FORCED_TOOL=

# --- Azure OpenAI ------------------------------------------------------------
AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_URL=
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-1
# AZURE_OPENAI_STORE=true

# --- Any OpenAI-compatible endpoint ------------------------------------------
OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_URL=

# --- Amazon Bedrock ----------------------------------------------------------
AWS_BEARER_TOKEN_BEDROCK=
# AWS_BEDROCK_REGION=us-east-1
# AWS_SESSION_TOKEN=
# AWS_USE_DEFAULT_CREDENTIALS=true
# AWS_BEDROCK_ASSUME_ROLE_ARN=
# AWS_BEDROCK_ASSUME_ROLE_SESSION_NAME=
# AWS_BEDROCK_ASSUME_ROLE_DURATION_SECONDS=
# AWS_BEDROCK_ASSUME_ROLE_EXTERNAL_ID=

# --- One-click connect (bring your own key) ----------------------------------
# Members sign in at the provider and come back with a working key.
# Register APP_FRONTEND_URL + BYOK_CONNECT_REDIRECT_PATH as the redirect URI
# with each OAuth provider below. OpenRouter needs no registration.
BYOK_CONNECT_OPENROUTER_ENABLED=true
BYOK_CONNECT_HUGGINGFACE_ENABLED=true
HUGGINGFACE_OAUTH_CLIENT_ID=
HUGGINGFACE_OAUTH_CLIENT_SECRET=
# Sign in with ChatGPT: keep off until OpenAI approves the app.
BYOK_CONNECT_CHATGPT_ENABLED=false
CHATGPT_OAUTH_CLIENT_ID=
CHATGPT_OAUTH_CLIENT_SECRET=
# CHATGPT_OAUTH_AUTHORIZE_URL=https://auth.openai.com/api/accounts/authorize
# CHATGPT_OAUTH_TOKEN_URL=https://auth.openai.com/api/accounts/oauth/token
# CHATGPT_OAUTH_SCOPES="openid profile email offline_access"
# Frontend path the provider redirects back to.
# BYOK_CONNECT_REDIRECT_PATH=/oauth/ai-provider-complete
# Name given to keys created at the provider. Defaults to APP_NAME.
# BYOK_CONNECT_KEY_LABEL=
# Hours between re-checks that a connected key still works.
# BYOK_RECHECK_AFTER_HOURS=6

# --- Embeddings --------------------------------------------------------------
# What knowledge sources embed with (openai, gemini, ollama…). Re-sync
# every source after changing it.
AI_EMBEDDINGS_PROVIDER=openai
GEMINI_EMBEDDINGS_DIMENSIONS=768

# --- Sandbox -----------------------------------------------------------------
E2B_API_KEY=
# E2B_API_URL=https://api.e2b.dev
# E2B_DOMAIN=e2b.app
# E2B_TEMPLATE=code-interpreter-v1

# =============================================================================
# AUTHENTICATION
# =============================================================================
# --- Login lockout -----------------------------------------------------------
# AUTH_LOCKOUT_MAX_ATTEMPTS=5
# AUTH_LOCKOUT_ATTEMPT_WINDOW=15
# AUTH_LOCKOUT_ESCALATION_WINDOW=24

# --- Passport ----------------------------------------------------------------
PASSPORT_PASSWORD_CLIENT_ID=
PASSPORT_PASSWORD_CLIENT_SECRET=

# --- Social login: Google ----------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/internal/auth/social/google/callback"

# --- Social login: GitHub ----------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/api/internal/auth/social/github/callback"

# =============================================================================
# BILLING (STRIPE & CASHIER)
# =============================================================================
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd
CASHIER_CURRENCY_LOCALE=en_US

# --- Billing intervals -------------------------------------------------------
# Estate-wide kill switch per billing window — withdraws an interval from
# sale across every plan. Existing subscriptions and lifetime grants on a
# disabled interval keep working; only new purchases are blocked.
BILLING_INTERVAL_MONTHLY_ENABLED=true
BILLING_INTERVAL_QUARTERLY_ENABLED=true
BILLING_INTERVAL_YEARLY_ENABLED=true
BILLING_INTERVAL_LIFETIME_ENABLED=false

# --- Plan: Starter -----------------------------------------------------------
STRIPE_PLAN_STARTER_PRODUCT_ID=
STRIPE_PLAN_STARTER_MONTHLY_PRICE_ID=
STRIPE_PLAN_STARTER_QUARTERLY_PRICE_ID=
STRIPE_PLAN_STARTER_YEARLY_PRICE_ID=
# One-time (not recurring) Stripe price — a lifetime purchase is a
# mode=payment Checkout Session, not a subscription.
STRIPE_PLAN_STARTER_LIFETIME_PRICE_ID=

# --- Plan: Pro ---------------------------------------------------------------
STRIPE_PLAN_PRO_PRODUCT_ID=
STRIPE_PLAN_PRO_MONTHLY_PRICE_ID=
STRIPE_PLAN_PRO_QUARTERLY_PRICE_ID=
STRIPE_PLAN_PRO_YEARLY_PRICE_ID=
STRIPE_PLAN_PRO_LIFETIME_PRICE_ID=

# --- Plan: Business ----------------------------------------------------------
STRIPE_PLAN_BUSINESS_PRODUCT_ID=
STRIPE_PLAN_BUSINESS_MONTHLY_PRICE_ID=
STRIPE_PLAN_BUSINESS_QUARTERLY_PRICE_ID=
STRIPE_PLAN_BUSINESS_YEARLY_PRICE_ID=

# --- Credits, fees & margins (config/billing.php) — defaults shown -----------
# BILLING_DEFAULT_PLAN=free
# off | on
# BILLING_KILL_SWITCH=off
# BILLING_CREDIT_VALUE_USD=0.005
# BILLING_OVERAGE_CREDIT_VALUE_USD=0.0065
# BILLING_OVERAGE_DEFAULT_LIMIT=1000000
# BILLING_OVERAGE_MINIMUM_INVOICE_CENTS=50
# BILLING_ORCHESTRATION_FEE_RATE=0.08
# BILLING_BYOK_ORCHESTRATION_FEE_RATE=0.16
# BILLING_PAYMENT_FEE_RATE=0.032
# BILLING_CACHE_READ_MULTIPLIER=1.0
# BILLING_CACHE_WRITE_MULTIPLIER=1.0
# BILLING_MARGIN_FLOOR_MONTHLY=0.0062
# BILLING_MARGIN_FLOOR_PREPAID=0.0054
# BILLING_MARGIN_LIFETIME_MONTHS=36
# BILLING_MIN_PLAN_COST_TIER_2=starter
# BILLING_MIN_PLAN_COST_TIER_3=pro
# BILLING_PRICE_ENFORCEMENT=warn
# BILLING_UNPRICED_FALLBACK=tier_max
# BILLING_UNPRICED_INPUT_PER_MTOK=15.0
# BILLING_UNPRICED_OUTPUT_PER_MTOK=75.0
# BILLING_REALTIME_NODE_BILLING=true
# BILLING_SHADOW_ENABLED=true
# BILLING_RESERVATIONS_ENABLED=true
# BILLING_RESERVATION_TTL_MINUTES=30
# BILLING_RESERVE_AGENT_TURN_CREDITS=40
# BILLING_RESERVE_AI_STEP_CREDITS=15
# BILLING_CREDIT_NOTIFICATION_MAX_THRESHOLDS=10
# BILLING_TRIAL_ENDING_WARNING_DAYS=3

# --- Credits charged per node run --------------------------------------------
# BILLING_NODE_COST_AGENT=3
# BILLING_NODE_COST_AI_IMAGE=10
# BILLING_NODE_COST_AI_SPEECH=3
# BILLING_NODE_COST_AI_TRANSCRIBE=3
# BILLING_NODE_COST_ENRICHMENT=2
# BILLING_NODE_COST_MAPS=1
# BILLING_NODE_COST_PAGE_TO_MARKDOWN=1
# BILLING_NODE_COST_RUN_CODE=3
# BILLING_NODE_COST_SEARCH=1
# BILLING_NODE_COST_SEARCH_EXTRACT=2
# BILLING_NODE_COST_WEB_SCRAPE=1

# --- Referrals ---------------------------------------------------------------
# Referral program: everything else is configured from the admin API.
REFERRALS_ENABLED=true
# REFERRALS_CACHE_TTL=300
# REFERRALS_PLAN_TIME_NOTICE_DAYS=3
# REFERRALS_VISIT_RETENTION_DAYS=90

# =============================================================================
# ADMIN ALERTS
# =============================================================================
ADMIN_ALERTS_ENABLED=true
ADMIN_ALERT_EMAILS=
ADMIN_ALERT_DISCORD_WEBHOOK=
ADMIN_ALERT_WEBHOOK_URL=
ADMIN_ALERT_WEBHOOK_SECRET=
ADMIN_ALERT_THROTTLE_SECONDS=3600
ADMIN_ALERT_USAGE_THRESHOLD_PERCENT=80

# =============================================================================
# SUPER ADMIN PANEL
# =============================================================================
# See docs/SUPER_ADMIN_PLAN.md. The one master switch: off, no Super Admin
# route exists, its tokens are refused and its commands won't run.
SUPER_ADMIN_ENABLED=false
# Origins of the Super Admin frontend (comma-separated), allowed by CORS while enabled.
# SUPER_ADMIN_ALLOWED_ORIGINS=
# Serve the API only on this host, and/or only to these IPs/CIDRs (comma-separated).
# SUPER_ADMIN_HOST=
# SUPER_ADMIN_ALLOWED_IPS=
# SUPER_ADMIN_ALERT_EMAILS=
# Who may open Horizon and Pulse outside local (IPs/CIDRs). Empty = nobody.
# SUPER_ADMIN_DASHBOARD_IPS=
# Hosts an AI endpoint may point at although private or plain http (comma-separated).
# SUPER_ADMIN_ENDPOINT_PRIVATE_HOSTS=
# Largest credit grant a single super admin action may make.
# SUPER_ADMIN_CREDIT_GRANT_MAX=100000

# --- Super Admin sign-in (config/super_admin_auth.php) -----------------------
# SUPER_ADMIN_ACCESS_TOKEN_MINUTES=15
# SUPER_ADMIN_REFRESH_TOKEN_DAYS=7
# SUPER_ADMIN_SESSION_ABSOLUTE_DAYS=30
# SUPER_ADMIN_PASSWORD_ROTATION_DAYS=90
# Check new passwords against known breaches (off in testing).
# SUPER_ADMIN_CHECK_COMPROMISED=true

# --- Super Admin alerts (config/super_admin_alerts.php) ----------------------
# SUPER_ADMIN_ALERTS_ENABLED=true
# SUPER_ADMIN_ALERT_ESCALATE_MINUTES=60
# SUPER_ADMIN_ALERT_QUIET_HOURS=false
# SUPER_ADMIN_ALERT_QUIET_START=22:00
# SUPER_ADMIN_ALERT_QUIET_END=07:00
# SUPER_ADMIN_ALERT_QUIET_TZ=UTC

# --- System health thresholds (config/super_admin_health.php) ----------------
# HEALTH_CHECK_TIMEOUT=5
# HEALTH_FAILED_JOBS_WARNING=25
# HEALTH_FAILED_JOBS_CRITICAL=200
# HEALTH_QUEUE_WAIT_WARNING=300
# HEALTH_QUEUE_WAIT_CRITICAL=900
# HEALTH_SCHEDULER_STALE_SECONDS=180
# HEALTH_SCHEDULER_OVERDUE_FACTOR=2.5
# HEALTH_STUCK_EVENTS_MINUTES=15
# HEALTH_STUCK_RUNS_MINUTES=60

# --- Model spend guard -------------------------------------------------------
# config/model_operations.php — alerts only, never blocks. US dollars of provider cost.
# MODEL_DAILY_BUDGET_USD=
# MODEL_WORKSPACE_DAILY_USD=
# MODEL_BUDGET_WARN_RATIO=0.8
# MODEL_WORKSPACE_AUTO_THROTTLE=true
# MODEL_WORKSPACE_SPIKE_FACTOR=5
# MODEL_WORKSPACE_SPIKE_MIN_USD=5
# MODEL_SLO_P95_LATENCY_MS=20000
# MODEL_SLO_SUCCESS_RATE=0.99
# MODEL_USAGE_ROLLUP_DAYS=2
# MODEL_PRICE_SYNC_ENABLED=true
# MODEL_PRICE_SYNC_FEED_URL=https://openrouter.ai/api/v1/models
# AI_CALL_LEDGER_ENABLED=true
# AI_CALL_LEDGER_RETENTION_DAYS=180

# --- Business intelligence (config/intelligence.php) -------------------------
# Who receives the daily briefing (comma-separated). Empty = nobody.
INTELLIGENCE_BRIEFING_EMAILS=
# INTELLIGENCE_BRIEFING_ENABLED=true
# Model the analyst agent runs on. Empty = the app default.
# INTELLIGENCE_ANALYST_MODEL=
# INTELLIGENCE_ANALYST_MAX_STEPS=8
# INTELLIGENCE_ROLLUP_DAYS=2
# INTELLIGENCE_THIN_MARGIN_PERCENT=20
# INTELLIGENCE_LOSS_WORKSPACE_USD=10
# INTELLIGENCE_INTERNAL_FEATURE_USD=20
# INTELLIGENCE_ABUSE_FREE_SPEND_USD=2
# INTELLIGENCE_FAILURE_RATE=0.05
# INTELLIGENCE_CACHE_HIT_RATE=0.1

# --- Free credits, trials and AI cost guardrails -----------------------------
# config/billing.php — defaults; every one can be changed in Super Admin
# (Pricing > Credit policies) without a deploy.
# Free plan credits only for the owner's first workspace, once their email is verified.
# BILLING_FREE_CREDITS_ONE_PER_OWNER=true
# BILLING_FREE_CREDITS_REQUIRE_VERIFIED_EMAIL=true
# One trial per person and per card; no trials on prepaid cards.
# BILLING_TRIALS_ONE_PER_USER=true
# BILLING_TRIALS_ONE_PER_CARD=true
# BILLING_TRIALS_BLOCK_PREPAID_CARDS=true
# enforce | shadow (record what would be denied, deny nothing) | off
# FREE_CREDIT_ENFORCEMENT=enforce
# BILLING_MAX_FREE_CLAIMS_PER_NETWORK_PER_DAY=3
# BILLING_BLOCK_DISPOSABLE_EMAIL=true
# Pauses free and trial workspaces for the rest of the UTC day once they cost this much in total.
# SET THESE BEFORE LAUNCH: unset (null) means no platform-wide spend breaker.
FREE_TIER_DAILY_BUDGET_USD=25
# Platform-wide daily provider budget in US dollars; at PLATFORM_AI_HARD_STOP_RATIO x this, new work stops.
PLATFORM_DAILY_AI_BUDGET_USD=200
# PLATFORM_AI_HARD_STOP_RATIO=1.5
# Seconds the free-tier spend sum is cached between starts (0 = always fresh).
# BILLING_FREE_TIER_SPEND_CACHE_SECONDS=30
# BILLING_GUARDRAILS_ENABLED=true

